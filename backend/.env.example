# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_ai_agency

# Redis / queue
REDIS_URL=redis://localhost:6379

# AI provider abstraction
AI_PROVIDER=mock
AI_MODEL=development-model
AI_API_KEY=

# Object storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=agency-artifacts
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Email provider
EMAIL_PROVIDER=mock
EMAIL_API_KEY=

# Security
SESSION_SECRET=replace-in-development-only
